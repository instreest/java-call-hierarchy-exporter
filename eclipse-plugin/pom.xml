<?xml version="1.0" encoding="UTF-8"?>
<!--
  Eclipse プラグイン（OSGi バンドル）を Eclipse 無しでビルドするための Maven 設定。

    cd eclipse-plugin && mvn package
      -> target/io.github.instreest.jche.eclipse-1.0.0.jar

  できた jar を Eclipse の dropins/ に置いて再起動すれば、プラグインとして使える。
  Eclipse 上で開発するときは PDE（.project / .classpath / build.properties / META-INF/MANIFEST.MF）を
  使うので、この pom.xml は「PDE 無しでもビルドできること」を CI で確かめるためのもの。
  バンドルの素性（Bundle-SymbolicName や依存）は MANIFEST.MF が唯一の正で、
  maven-jar-plugin にその MANIFEST.MF をそのまま入れさせている（二重管理にしない）。

  Tycho を使わない理由、依存の版を MANIFEST.MF と揃える方法は docs/eclipse-plugin-qa.md
  （Q7・Q8）にまとめてある。プラグイン本体のソースは複製せず、リポジトリ直下の src/ を
  そのままコンパイル対象にする（build-helper で ../src を足している）。

  JDT の版は //DEPS 行・リポジトリ直下の pom.xml と同じでなければならない
  （test/plugin/run.sh が食い違いを検出する）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.instreest</groupId>
  <artifactId>io.github.instreest.jche.eclipse</artifactId>
  <!-- MANIFEST.MF の Bundle-Version と同じ -->
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- MANIFEST.MF の Bundle-RequiredExecutionEnvironment: JavaSE-17 と同じ -->
    <maven.compiler.release>17</maven.compiler.release>
    <!--
      JDT の版。ここは「バンドルに同梱して子プロセスで使う版」で、//DEPS 行と同じにする
      （CLI と同じ JDT で解析するため）。解析は Eclipse ではなく子プロセスで走るので、
      Eclipse 側の JDT の版は解析能力に関係しない。

      プラグインが Eclipse 側に要求する JDT の下限は MANIFEST.MF の
      Require-Bundle（org.eclipse.jdt.core;bundle-version）で、こちらは
      IMethod / Signature などモデル API を使うためだけのもの。下限の版でも
      コンパイルが通ることは CI が -Djdt.version=<下限> で検査する。

      版の対応表（Eclipse / JDT / Pleiades / 必要な Java）は
      docs/eclipse-pleiades-versions.md にある。
    -->
    <jdt.version>3.46.0</jdt.version>
  </properties>

  <dependencies>
    <!-- 解析本体が使う JDT。版は //DEPS 行と同じであること -->
    <dependency>
      <groupId>org.eclipse.jdt</groupId>
      <artifactId>org.eclipse.jdt.core</artifactId>
      <version>${jdt.version}</version>
    </dependency>

    <!-- プラグイン側（src-ui）が使う Eclipse の API。実行時は Eclipse 本体のものを使うので provided。
         版は Pleiades 2026-06 相当。MANIFEST.MF の Require-Bundle に書いた下限以上であればよい -->
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.ui.workbench</artifactId>
      <version>3.140.0</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.ui.console</artifactId>
      <version>3.17.100</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.jface</artifactId>
      <version>3.40.0</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.commands</artifactId>
      <version>3.13.0</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.resources</artifactId>
      <version>3.24.100</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.runtime</artifactId>
      <version>3.35.0</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.jobs</artifactId>
      <version>3.15.900</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.equinox.common</artifactId>
      <version>3.21.0</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.osgi</artifactId>
      <version>3.24.300</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.swt</artifactId>
      <version>3.135.0</version>
      <scope>provided</scope>
      <exclusions>
        <!-- org.eclipse.platform の POM は Maven Central に無い成果物（com.sun.jna 等）を
             バージョン範囲で参照していて、そのままでは解決に失敗する。
             ここで要るのはコンパイル用の API だけなので推移的な依存はすべて切る
             （docs/eclipse-plugin-qa.md の Q8） -->
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.ui.ide</artifactId>
      <version>3.23.200</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.jface.text</artifactId>
      <version>3.31.100</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.text</artifactId>
      <version>3.14.800</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.ui.workbench.texteditor</artifactId>
      <version>3.20.200</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!--
      SWT の実体はプラットフォームごとの断片（fragment）にある。org.eclipse.swt だけでは
      Composite や Button のクラスが入っていないのでコンパイルできない。
      ここで足すのは「コンパイルを通すため」だけで、実行時は Eclipse 本体の断片が使われる。
      どの断片でも API は同じなので、Windows で mvn package しても差は無い
      （docs/eclipse-plugin-ui-qa.md の Q7）。
    -->
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.swt.gtk.linux.x86_64</artifactId>
      <version>3.135.0</version>
      <scope>provided</scope>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!--
      解析の子プロセスで要る jar（lib/jdt/ に同梱する）。コンパイルには使わないが、
      推移的な依存を全部切っているので、ここで名前を挙げないと集められない
    -->
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.core.contenttype</artifactId>
      <version>3.9.900</version>
      <scope>provided</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.eclipse.platform</groupId>
      <artifactId>org.eclipse.equinox.preferences</artifactId>
      <version>3.12.100</version>
      <scope>provided</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.prefs</artifactId>
      <version>1.1.2</version>
      <scope>provided</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <!-- プラグイン固有のコード。解析本体（../src）は build-helper で足す -->
    <sourceDirectory>src-ui</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-core-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${project.basedir}/../src</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <!-- 本体（リポジトリ直下の src/）は GitHub Actions で -Xlint:all -Werror を通している。
               プラグイン側も同じ目で見る。Eclipse の API は非推奨のものを避けて書いてあるので、
               ここも警告ゼロで通る -->
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!--
        子プロセスに渡すものを target/classes/lib/ に集める。バンドルの中には入るが
        Bundle-ClassPath には載せないので、Eclipse（古い JDK かもしれない）は読まない。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>bundle-jdt</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/lib/jdt</outputDirectory>
              <!--
                provided で宣言した Eclipse API（コンパイル用）と、jdt.core の推移的依存の
                両方から拾う必要があるので test スコープまで含める。実際に入れるのは
                下の includeArtifactIds に挙げたものだけ
              -->
              <includeScope>test</includeScope>
              <!--
                解析に実際に要る jar だけ。この組み合わせで test/demo を解析し、CSV が
                期待値と一致することを確認してある（jna・osgi.annotation・core.commands・
                core.expressions・equinox.app は不要。約 3.9MB ぶん削れる）
              -->
              <includeArtifactIds>ecj,org.eclipse.jdt.core,org.eclipse.osgi,org.eclipse.text,org.eclipse.core.contenttype,org.eclipse.core.filesystem,org.eclipse.core.jobs,org.eclipse.core.resources,org.eclipse.core.runtime,org.eclipse.equinox.common,org.eclipse.equinox.preferences,org.eclipse.equinox.registry,org.osgi.service.prefs</includeArtifactIds>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <!--
            解析本体（リポジトリ直下の src/）を1つの jar にまとめ、lib/ へ置く。
            これを子プロセスの -cp に渡す。Eclipse の中では読まれない
          -->
          <execution>
            <id>core-jar</id>
            <phase>prepare-package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classesDirectory>${project.build.outputDirectory}</classesDirectory>
              <outputDirectory>${project.build.outputDirectory}/lib</outputDirectory>
              <!-- finalName + classifier で lib/jche-core.jar になる。classifier を付けるのは
                   Maven に「本体の jar を置き換えるのではなく別物だ」と分からせるため -->
              <finalName>jche</finalName>
              <classifier>core</classifier>
              <includes>
                <include>CallHierarchyExporter*.class</include>
                <include>jche/**</include>
              </includes>
              <excludes>
                <exclude>jche/eclipse/**</exclude>
                <exclude>lib/**</exclude>
              </excludes>
              <archive>
                <manifest><mainClass>CallHierarchyExporter</mainClass></manifest>
              </archive>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <!-- バンドル本体には、プラグインのクラスと lib/ だけを入れる -->
          <includes>
            <include>jche/eclipse/**</include>
            <include>lib/**</include>
            <include>plugin.xml</include>
          </includes>
          <archive>
            <!-- OSGi の情報は MANIFEST.MF が唯一の正。PDE と同じものを使う -->
            <manifestFile>META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
    </plugins>
    <resources>
      <resource>
        <directory>${project.basedir}</directory>
        <includes><include>plugin.xml</include></includes>
      </resource>
    </resources>
  </build>
</project>
