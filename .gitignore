build/
bin/
lib/
out/
dist/

# pom.xml（Eclipse の m2e 用）でビルドしたときの出力先
target/

# jbangw/.jbang/jbang.jar を置くと、ラッパー（jbangw/jbang）はダウンロードせずにそれを使う。
# 置いた場合もコミットしない（14MB 超）
/jbangw/.jbang/

# 起動コマンド（jche / jche.cmd）の設定と、「JDK / JBang をこのプロジェクトの中に置く」を選んだときの置き場所。
# どちらも環境ごとのもの（パス・ヒープ上限・数百 MB の JDK）なので追跡しない
/launcher.properties
/.jbang/
# 対話モードの「設定ファイルを新しく作る」が書く先。解析対象ごとのローカルな設定なので追跡しない
# （共有したいものは別の場所に置いて p でパスを指定するか、この行を消す）。その出力（output.folder の既定）も同様
/configs/
*.class
.classpath
.project
.settings/
.idea/
*.iml

# 実行時に生成される解析キャッシュと出力。
# キャッシュはツールのプロジェクトフォルダ直下の .cache/ に解析対象プロジェクトごとに作られる
# （cache.folder が空欄のとき。設定ファイルの場所によらない）。
# 出力は同梱の config.properties の既定値（output.folder=./output）が書き出す先。output.folder の
# 相対パスは「設定ファイルが置かれているディレクトリ」が起点なので、設定ファイルをリポジトリ内の
# 別の場所へコピーして使う場合は、その出力先も各自で足すこと。
/.cache/
/output/

# 回帰テストの実行結果（期待出力 expected/ は追跡する）
/test/regression/*/output/
/test/regression/*/.cache/
/test/regression/*/run*.log
/test/regression/run-*.log

# サンプルの Maven / Gradle プロジェクト（test/maven-demo, test/maven-multi, test/gradle-demo）を
# ビルドしたときの出力。回帰テストはビルドしない（ビルドファイルを読むだけ）が、手で試したとき用
/test/*/target/
/test/*/*/target/
/test/*/.gradle/

# test/gradle-demo/app は Eclipse（Buildship）で開いた形のサンプルなので、そのメタデータは追跡する
# （上の .project / .classpath の除外はこのツール自身のもの）
!/test/gradle-demo/app/.project
!/test/gradle-demo/app/.classpath

# test/cli/run.sh の実行ログ
/test/cli/run-*.log
