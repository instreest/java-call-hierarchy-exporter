build/
bin/
lib/
out/
dist/

# pom.xml（Eclipse の m2e 用）でビルドしたときの出力先
target/

# jbangw/.jbang/jbang.jar を置くと、ラッパー（jbangw/jbang）はダウンロードせずにそれを使う。
# 置いた場合もコミットしない（14MB 超）
/jbangw/.jbang/

# 起動コマンド（java-call-hierarchy-exporter.sh / java-call-hierarchy-exporter.cmd）の設定と、「JDK / JBang をこのプロジェクトの中に置く」を選んだときの置き場所。
# どちらも環境ごとのもの（パス・ヒープ上限・数百 MB の JDK）なので追跡しない
/launcher.properties
/.jbang/
*.class
.classpath
.project
.settings/
.idea/
*.iml

# 実行時に生成される解析キャッシュと出力。
# キャッシュはツールのプロジェクトフォルダ直下の .cache/ に解析対象プロジェクトごとに作られる
# （cache.folder が空欄のとき。設定ファイルの場所によらない）。
# 出力は同梱の config/config.properties の既定値（output.folder=. ＝設定ファイルと同じフォルダ）が
# 書き出す先。実行ごとに config/<解析開始日時>_<プロジェクト名>/ ができるので、config/ 直下の
# フォルダを除外する（設定ファイル自体は追跡する）。設定ファイルをリポジトリ内の別の場所へ
# コピーして使う場合は、その出力先も各自で足すこと。
/.cache/
/config/*/

# 回帰テストの実行結果（期待出力 expected/ は追跡する）
/test/regression/*/output/
/test/regression/*/.cache/
/test/regression/*/run*.log
/test/regression/run-*.log
# multi ケースが JCHE_OUTPUT_DIR_FILE の検査に使う（出力フォルダの一覧）
/test/regression/output-dirs.txt

# GitHub Actions（action.yml）の output-folder の既定値。このリポジトリ自身のワークフローで
# アクションを動かしたときの出力先でもある
/call-hierarchy-output/

# サンプルの Maven / Gradle プロジェクト（test/maven-demo, test/maven-multi, test/gradle-demo）を
# ビルドしたときの出力。回帰テストはビルドしない（ビルドファイルを読むだけ）が、手で試したとき用
/test/*/target/
/test/*/*/target/
/test/*/.gradle/

# test/gradle-demo/app は Eclipse（Buildship）で開いた形のサンプルなので、そのメタデータは追跡する
# （上の .project / .classpath の除外はこのツール自身のもの）
!/test/gradle-demo/app/.project
!/test/gradle-demo/app/.classpath

# test/cli/run.sh の実行ログ
/test/cli/run-*.log

# test/dataflow/run.sh（解決の決定性・値の表の検査）のコンパイル結果・キャッシュ・出力。
# work/ は ValueStoreCheck が解析するプロジェクトごとのキャッシュ・出力とログ
/test/dataflow/build/
/test/dataflow/.cache/
/test/dataflow/output/
/test/dataflow/work/

# test/incremental/run.sh（差分更新の検査）が作るもの。
# 解析対象は src/ を複製した work/ で、書き換えるのはそちらだけ（src/ は汚さない）。
# *.tsv は差分更新・全件解析それぞれのキャッシュの複製（比較用）
/test/incremental/build/
/test/incremental/work/
/test/incremental/.cache/
/test/incremental/out/
/test/incremental/out.log
/test/incremental/*.tsv
/test/incremental/case.properties
/test/incremental/cut.tmp
/test/incremental/jarorder.properties
/test/incremental/jarwork/
# 強制終了（SIGTERM）で一時ファイルが残らないことを見るケースの作業フォルダ
/test/incremental/killwork/
# 同じキャッシュのフォルダを使う実行・解析のあいだの書き換え・同じクラスが 2 つの検査の作業フォルダと、検査用のプログラム（tools/）のコンパイル結果
/test/incremental/integrity/

# test/cacheversion/run.sh（キャッシュの形式の版の上げ忘れの検査）のコンパイル結果・キャッシュ・出力
/test/cacheversion/build/
/test/cacheversion/.cache/
/test/cacheversion/out/
/test/cacheversion/out.log

# test/ctorbody/run.sh（コンストラクタ本体の読み取りの検査）が作る使い捨てのプロジェクト
/test/ctorbody/work/

# test/pruning/run.sh（値の読み違いで呼び出しを落とさないことの検査）のコンパイル結果と使い捨てのプロジェクト
/test/pruning/build/
/test/pruning/work/

# test/jls/run.sh（JLS SE 26 への適合と javac との整合の検査）のコンパイル結果（ツールと javac 26）・
# 実行ログと、解析のキャッシュ（出力の project/out/ は上の out/ で除外済み）
/test/jls/build/
/test/jls/project/.cache/

# test/warnings/run.sh（warnings.txt の検査）のコンパイル結果と使い捨てのプロジェクト
/test/warnings/build/
/test/warnings/work/

# test/cachevalue/run.sh（キャッシュの列の符号化の検査）のコンパイル結果
/test/cachevalue/build/
/test/cachevalue/check/

# test/contracts/run.sh（同梱の契約表の検査）のコンパイル結果
/test/contracts/build/
/test/contracts/check/

# test/nls/run.sh（文言の検査）のコンパイル結果・キャッシュ・出力。
# 英語と日本語で 2 回解析して、CSV が同じになることを見るためのもの
/test/nls/build/
/test/nls/.cache/
/test/nls/output/

# test/conditions/run.sh（条件の調査の検査）が作るもの。
# ケースごとの設定ファイル（case.properties）とコンパイル結果・実行ログのほか、
# 「通常の解析ならできる」ことを見るためのキャッシュと出力フォルダ
/test/conditions/build/
/test/conditions/out.log
/test/conditions/case.properties
/test/conditions/.cache/
/test/conditions/out/

# VSCode プラグイン（vscode-plugin/）。npm の依存と、esbuild の出力（dist/ out/ は上で除外済み）。
# package-lock.json は追跡する（CI の npm ci が同じ版を入れるため）
/vscode-plugin/node_modules/
/vscode-plugin/*.vsix
