<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ant用ビルドスクリプト。

  依存関係の解決は Gradle で行う前提です。先に次を実行して lib/ を用意してください。

      gradle copyDeps        (build/dist/lib に依存jarが集まります)

  そのうえで lib/ をこの build.xml と同じ階層に置くか、-Dlib.dir=... で指定します。

      ant -Dlib.dir=build/dist/lib dist
      ant -Dlib.dir=build/dist/lib run -Dconfig.file=config/config.properties

  Gradleを一切使えない環境では、Eclipse(Pleiades)の plugins/ から
  org.eclipse.jdt.core_*.jar とその依存を lib/ にコピーしても動きます
  （詳しくは README の「Gradleを使わない場合」を参照）。
-->
<project name="java-call-hierarchy-exporter" default="dist" basedir=".">

    <property name="src.dir" value="src/main/java"/>
    <property name="build.dir" value="build/ant/classes"/>
    <property name="dist.dir" value="build/ant/dist"/>
    <property name="lib.dir" value="lib"/>
    <property name="main.class" value="jp.co.example.callhierarchy.CallHierarchyExporter"/>

    <path id="classpath">
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="clean">
        <delete dir="build/ant"/>
    </target>

    <target name="compile">
        <mkdir dir="${build.dir}"/>
        <!-- debug="true" は必須。Antの既定は false で、行番号情報が失われます -->
        <javac srcdir="${src.dir}" destdir="${build.dir}"
               includeantruntime="false" encoding="UTF-8" debug="true"
               source="11" target="11">
            <classpath refid="classpath"/>
        </javac>
    </target>

    <target name="dist" depends="compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/java-call-hierarchy-exporter.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <!-- 実行例: ant run -Dconfig.file=config/config.properties -->
    <target name="run" depends="dist">
        <fail unless="config.file" message="使い方: ant run -Dconfig.file=設定ファイルのパス"/>
        <java classname="${main.class}" fork="true" failonerror="true">
            <jvmarg value="-Xmx2g"/>
            <jvmarg value="-Dfile.encoding=UTF-8"/>
            <classpath>
                <path refid="classpath"/>
                <pathelement location="${dist.dir}/java-call-hierarchy-exporter.jar"/>
            </classpath>
            <arg value="${config.file}"/>
        </java>
    </target>

</project>
