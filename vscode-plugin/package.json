{
  "name": "java-call-hierarchy-exporter",
  "displayName": "Java Call Hierarchy Exporter",
  "description": "Java プロジェクトの呼び出し階層を一括解析し、影響調査のための呼び出し元ツリーと CSV を出す",
  "version": "0.1.0",
  "publisher": "instreest",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/instreest/java-call-hierarchy-exporter"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jche",
          "title": "影響調査",
          "icon": "$(references)"
        }
      ]
    },
    "views": {
      "jche": [
        {
          "id": "jche.callers",
          "name": "影響調査 (Call Hierarchy Exporter)",
          "contextualTitle": "影響調査 (Call Hierarchy Exporter)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "jche.callers",
        "contents": "Java プロジェクト全体の呼び出し階層を一括で解析し、改修の影響範囲を辿るためのビューです。\n\n標準の「呼び出し階層」（Shift+Alt+H）が開いているファイルから即座に引くのに対し、こちらはプロジェクト全体を Eclipse JDT で解析してから、インタフェース経由・データフロー経由の呼び出し元まで含めて一括で辿ります。解析には時間がかかります。\n\n[解析する](command:jche.analyze)\n\n解析が終わったら、エディタでメソッドにカーソルを置き、右クリック →「影響調査: 呼び出し元を表示」。",
        "when": "workspaceFolderCount > 0"
      },
      {
        "view": "jche.callers",
        "contents": "フォルダを開くと使えます。\n[フォルダを開く](command:vscode.openFolder)",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "jche.showCallers",
        "title": "影響調査: 呼び出し元を表示",
        "icon": "$(references)"
      },
      {
        "command": "jche.analyze",
        "category": "影響調査",
        "title": "解析する",
        "icon": "$(refresh)"
      },
      {
        "command": "jche.cancel",
        "category": "影響調査",
        "title": "解析を中止する",
        "icon": "$(stop-circle)"
      },
      {
        "command": "jche.toggleDirection",
        "category": "影響調査",
        "title": "方向を切り替える（呼び出し元 ⇄ 呼び出し先）",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "jche.setRoot",
        "category": "影響調査",
        "title": "ここを起点にする"
      },
      {
        "command": "jche.openDeclaration",
        "category": "影響調査",
        "title": "宣言を開く"
      },
      {
        "command": "jche.openLog",
        "category": "影響調査",
        "title": "ログを開く",
        "icon": "$(output)"
      },
      {
        "command": "jche.saveConfig",
        "category": "影響調査",
        "title": "設定を config.properties に保存"
      },
      {
        "command": "jche.selectConfig",
        "category": "影響調査",
        "title": "設定ファイルを選ぶ"
      },
      {
        "command": "jche.filterText",
        "category": "影響調査",
        "title": "絞り込み文字列",
        "icon": "$(search)"
      },
      {
        "command": "jche.filterOptions",
        "category": "影響調査",
        "title": "フィルタ設定（深さ・テスト・推定・重複）",
        "icon": "$(filter)"
      },
      {
        "command": "jche.export",
        "category": "影響調査",
        "title": "この木を CSV に出す",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "jche.showCallers",
          "when": "resourceLangId == java",
          "group": "navigation@9"
        }
      ],
      "view/title": [
        {
          "command": "jche.filterText",
          "when": "view == jche.callers",
          "group": "navigation@0"
        },
        {
          "command": "jche.toggleDirection",
          "when": "view == jche.callers",
          "group": "navigation@1"
        },
        {
          "command": "jche.analyze",
          "when": "view == jche.callers && !jche.analyzing",
          "group": "navigation@2"
        },
        {
          "command": "jche.cancel",
          "when": "view == jche.callers && jche.analyzing",
          "group": "navigation@2"
        },
        {
          "command": "jche.filterOptions",
          "when": "view == jche.callers",
          "group": "navigation@3"
        },
        {
          "command": "jche.export",
          "when": "view == jche.callers && jche.hasTree",
          "group": "navigation@4"
        },
        {
          "command": "jche.openLog",
          "when": "view == jche.callers",
          "group": "navigation@9"
        },
        {
          "command": "jche.selectConfig",
          "when": "view == jche.callers",
          "group": "config@1"
        },
        {
          "command": "jche.saveConfig",
          "when": "view == jche.callers",
          "group": "config@2"
        }
      ],
      "view/item/context": [
        {
          "command": "jche.setRoot",
          "when": "view == jche.callers && viewItem =~ /method/",
          "group": "navigation@1"
        },
        {
          "command": "jche.openDeclaration",
          "when": "view == jche.callers && viewItem =~ /source/",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "jche.setRoot",
          "when": "false"
        },
        {
          "command": "jche.openDeclaration",
          "when": "false"
        },
        {
          "command": "jche.cancel",
          "when": "jche.analyzing"
        },
        {
          "command": "jche.export",
          "when": "jche.hasTree"
        }
      ]
    },
    "configuration": {
      "title": "Call Hierarchy Exporter",
      "properties": {
        "jche.javaHome": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "解析に使う JDK のフォルダ（17 以上。CLI と結果を揃えるなら 25）。空欄なら `JAVA_HOME` → PATH の `java` の順に探します。解析は VSCode とは別のプロセスで走るので、vscode-java の設定とは独立です。"
        },
        "jche.libFolder": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "解析本体（`jche-core.jar` と `jdt/*.jar`）のフォルダ。空欄なら拡張に同梱の `lib/` を使います。閉域で新しい JDT に差し替えたいとき、または開発中に `eclipse-plugin/target/classes/lib` を指すときに使います。"
        },
        "jche.vmArguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "子プロセスの JVM に渡す引数。大きなプロジェクトでは `-Xmx4g` などを足します。VSCode のヒープとは独立です。"
        },
        "jche.idleMinutes": {
          "type": "integer",
          "default": 10,
          "minimum": 0,
          "markdownDescription": "問い合わせが無いままこの分数が過ぎたら子プロセスを終了します（メモリを返す）。`0` で常駐。次の問い合わせのときにキャッシュから作り直します。"
        },
        "jche.configFile": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "解析に使う設定ファイル（ワークスペースフォルダからの相対パス）。空欄ならフォルダ直下の `config.properties` を使い、無ければ `project.root` だけの設定を自動生成します（ソースフォルダ・依存 jar は `pom.xml` / `build.gradle` / フォルダ構成から決めます）。"
        },
        "jche.depth": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "木を一度に展開する深さの**初期値**。ビューのフィルタ設定で変えると、そちらをワークスペースごとに覚えます。深さの上限で打ち切られた節点は、開いたときに続きを取り寄せます。設定ファイルの `max.depth` とは独立です。"
        },
        "jche.autoAnalyze": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Java のファイルを保存・追加・削除したあと 3 秒静止したら、裏で再解析します。既定は OFF で、変更されたファイル数だけを数えて右下の状態に出します（⟳ で再解析）。差分解析なので 1 ファイル直しただけなら数秒で終わりますが、保存のたびに裏で走るのが気になるなら OFF のままにしてください。"
        },
        "jche.jdkDownload": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "解析に使う JDK が見つからないときに、Adoptium（Eclipse Temurin）から JDK 25 を取得する提案を出します（約 200MB。必ず確認してから取得します）。閉域環境では OFF にして `jche.javaHome` を指定してください。"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.mjs",
    "build:test": "node esbuild.mjs --test",
    "test": "npm run typecheck && npm run build:test && node --test \"out/test/*.test.js\"",
    "lib": "bash scripts/collect-lib.sh",
    "package": "npm run build && vsce package --no-dependencies --out java-call-hierarchy-exporter.vsix"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
